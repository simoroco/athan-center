# systemd service for Masjid Center
# This file allows Masjid Center to start automatically at Raspberry Pi boot

# Installation:
# 1. Update WorkingDirectory with the absolute path of your installation
# 2. Copy this file: sudo cp masjid-center.service /etc/systemd/system/
# 3. Enable the service: sudo systemctl enable masjid-center
# 4. Start the service: sudo systemctl start masjid-center

[Unit]
Description=Masjid Center - Islamic Prayer Times
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# IMPORTANT: Update this path with the absolute path of your installation
WorkingDirectory=/home/pi/masjid-center/web/masjid-center/deploy_prod

# Stop and start commands
ExecStart=/usr/bin/docker-compose up -d
ExecStop=/usr/bin/docker-compose down

# Automatic restart on failure
Restart=on-failure
RestartSec=10

# User (update if needed)
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
